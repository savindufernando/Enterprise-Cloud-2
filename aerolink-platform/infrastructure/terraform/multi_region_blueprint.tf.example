# ==============================================================================
# AeroLink Airline Systems Platform — Enterprise Multi-Region IaC Blueprint
# File: multi_region_blueprint.tf.example
# ==============================================================================
#
# PURPOSE:
# This blueprint defines the production-grade Infrastructure-as-Code (IaC) for 
# a global active-active deployment across two AWS Regions:
#   - Primary:   eu-west-1 (Ireland)
#   - Secondary: us-east-1 (N. Virginia)
#
# DESIGN NOTE:
# To prevent exceeding AWS Academy/Learner budget limits ($100 sandbox total cap, 
# which instantly terminates active resources on exhaustion), this blueprint 
# is stored as a declarative example. The live production environment runs on 
# a cost-optimized Multi-AZ layout inside eu-west-1.
#
# ==============================================================================

# --- Providers Configuration ---

provider "aws" {
  alias  = "primary"
  region = "eu-west-1"
}

provider "aws" {
  alias  = "secondary"
  region = "us-east-1"
}

# --- Variables ---

variable "domain_name" {
  type    = string
  default = "aerolink.transnova.shop"
}

# ==============================================================================
# 1. NETWORKING LAYER (Multi-Region VPCs)
# ==============================================================================

# VPC - Primary Region (Ireland)
module "vpc_primary" {
  source  = "terraform-aws-modules/vpc/aws"
  version = "5.5.0"
  providers = {
    aws = aws.primary
  }

  name = "aerolink-vpc-primary"
  cidr = "10.1.0.0/16"

  azs             = ["eu-west-1a", "eu-west-1b", "eu-west-1c"]
  private_subnets = ["10.1.1.0/24", "10.1.2.0/24", "10.1.3.0/24"]
  public_subnets  = ["10.1.101.0/24", "10.1.102.0/24", "10.1.103.0/24"]

  enable_nat_gateway = true
  single_nat_gateway = true
}

# VPC - Secondary Region (N. Virginia)
module "vpc_secondary" {
  source  = "terraform-aws-modules/vpc/aws"
  version = "5.5.0"
  providers = {
    aws = aws.secondary
  }

  name = "aerolink-vpc-secondary"
  cidr = "10.2.0.0/16"

  azs             = ["us-east-1a", "us-east-1b", "us-east-1c"]
  private_subnets = ["10.2.1.0/24", "10.2.2.0/24", "10.2.3.0/24"]
  public_subnets  = ["10.2.101.0/24", "10.2.102.0/24", "10.2.103.0/24"]

  enable_nat_gateway = true
  single_nat_gateway = true
}

# ==============================================================================
# 2. COMPUTE LAYER (Multi-Region EKS Clusters)
# ==============================================================================

# EKS Cluster - Primary Region
module "eks_primary" {
  source  = "terraform-aws-modules/eks/aws"
  version = "~> 20.0"
  providers = {
    aws = aws.primary
  }

  cluster_name    = "aerolink-cluster-primary"
  cluster_version = "1.30"
  vpc_id          = module.vpc_primary.vpc_id
  subnet_ids      = module.vpc_primary.private_subnets

  eks_managed_node_groups = {
    worker = {
      instance_types = ["t3.small"]
      min_size       = 1
      max_size       = 4
      desired_size   = 3
    }
  }
}

# EKS Cluster - Secondary Region
module "eks_secondary" {
  source  = "terraform-aws-modules/eks/aws"
  version = "~> 20.0"
  providers = {
    aws = aws.secondary
  }

  cluster_name    = "aerolink-cluster-secondary"
  cluster_version = "1.30"
  vpc_id          = module.vpc_secondary.vpc_id
  subnet_ids      = module.vpc_secondary.private_subnets

  eks_managed_node_groups = {
    worker = {
      instance_types = ["t3.small"]
      min_size       = 1
      max_size       = 4
      desired_size   = 3
    }
  }
}

# ==============================================================================
# 3. DATABASE LAYER (Multi-Region Global Persistence)
# ==============================================================================

# DynamoDB Global Table (Multi-Region Active-Active Replication)
resource "aws_dynamodb_table" "baggage_global_table" {
  provider     = aws.primary
  name         = "aerolink-baggage-global"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "baggage_id"

  attribute {
    name = "baggage_id"
    type = "S"
  }

  # Enable streams required for global replication
  stream_enabled   = true
  stream_view_type = "NEW_AND_OLD_IMAGES"

  # Replicate to N. Virginia (us-east-1)
  replica {
    region_name = "us-east-1"
  }
}

# ==============================================================================
# 4. GLOBAL TRAFFIC MANAGEMENT LAYER (Route 53 Geo-Latency Routing)
# ==============================================================================

# Primary Hosted Zone
resource "aws_route53_zone" "aerolink" {
  provider = aws.primary
  name     = var.domain_name
}

# Latency routing record to Primary Region (Ireland)
resource "aws_route53_record" "api_primary" {
  provider = aws.primary
  zone_id  = aws_route53_zone.aerolink.zone_id
  name     = "api.${var.domain_name}"
  type     = "CNAME"
  ttl      = "60"

  latency_routing_policy {
    region = "eu-west-1"
  }

  set_identifier = "api-eu-west-1"
  records        = ["a05e1d9afebe84dd6b770601462debf3-107452267.eu-west-1.elb.amazonaws.com"] # Primary ALB Endpoint
}

# Latency routing record to Secondary Region (N. Virginia)
resource "aws_route53_record" "api_secondary" {
  provider = aws.primary
  zone_id  = aws_route53_zone.aerolink.zone_id
  name     = "api.${var.domain_name}"
  type     = "CNAME"
  ttl      = "60"

  latency_routing_policy {
    region = "us-east-1"
  }

  set_identifier = "api-us-east-1"
  records        = ["ad174fba7b8be44a6bd43029fbf9721-399874100.us-east-1.elb.amazonaws.com"] # Secondary ALB Endpoint (Simulated)
}
